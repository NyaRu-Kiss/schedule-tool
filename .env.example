# ========================================
# 日程效率工具 - 环境变量配置
# ========================================
# 复制本文件为 .env，填入你的配置后启动服务：
#   cp .env.example .env
#   vim .env
#   python3 cli.py server

# ---------- Webhook 推送（核心配置）----------
# 推送目标 URL。留空则只打印控制台，不实际推送。
# 自建平台示例:  http://your-server.com/api/notify
# 企业微信群机器人: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
# 飞书自定义机器人:  https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_HOOK_ID
SCHEDULE_WEBHOOK_URL=

# 消息格式: generic | wecom | feishu | custom
#   generic  — 通用 JSON，body: {"event":"reminder","text":"...","count":N,"items":[...]} （适合自建平台）
#   wecom    — 企业微信群机器人格式
#   feishu   — 飞书自定义机器人格式
#   custom   — 使用 SCHEDULE_WEBHOOK_TEMPLATE 模板渲染
SCHEDULE_WEBHOOK_FORMAT=generic

# 请求超时秒数
SCHEDULE_WEBHOOK_TIMEOUT=8

# 失败重试次数（指数退避: 1s, 2s, 4s...）
SCHEDULE_WEBHOOK_RETRY=3

# 自定义请求头（JSON 字符串），按需填写
# 例: {"Authorization":"Bearer token123","X-Source":"schedule-tool"}
SCHEDULE_WEBHOOK_HEADERS=

# 自定义消息体模板（format=custom 时生效）
# 可用变量: {text} {count} {items_json}
SCHEDULE_WEBHOOK_TEMPLATE={"event":"reminder","message":"{text}","count":{count}}

# ---------- 提醒 ----------
# 提前 N 分钟发送提醒
SCHEDULE_REMIND_LEAD_MINUTES=5

# 后台扫描间隔（秒）
SCHEDULE_SCAN_INTERVAL_SECONDS=30

# ---------- 服务 ----------
SCHEDULE_HOST=0.0.0.0
SCHEDULE_PORT=7800

# ---------- 数据库 ----------
SCHEDULE_DB_PATH=

# 数据库后端：sqlite（默认）或 mysql。使用 mysql 时请先创建独立数据库。
SCHEDULE_DB_BACKEND=sqlite
SCHEDULE_DB_HOST=127.0.0.1
SCHEDULE_DB_PORT=3306
SCHEDULE_DB_USER=root
SCHEDULE_DB_PASSWORD=
SCHEDULE_DB_NAME=agenda_tool

# Agent 调用后端的服务认证令牌（生产环境必填）
SCHEDULE_INTERNAL_SERVICE_TOKEN=

# ---------- Agent 意图解析（可切换的 OpenAI 兼容 Chat Completions API）----------
# 三项全部留空时使用内置确定性解析。配置 provider 后填写 API key。
# deepseek 默认使用 https://api.deepseek.com/v1 + deepseek-chat。
# openai 默认使用 https://api.openai.com/v1 + gpt-4o-mini。
# custom 需要同时填写 BASE_URL 和 MODEL。BASE_URL 不包含 /chat/completions。
SCHEDULE_LLM_PROVIDER=deepseek
SCHEDULE_LLM_BASE_URL=
SCHEDULE_LLM_MODEL=
SCHEDULE_LLM_API_KEY=
SCHEDULE_LLM_TIMEOUT=20

# ---------- 编排 ----------
SCHEDULE_DEFAULT_ESTIMATE_MINUTES=30
SCHEDULE_HORIZON_DAYS=7

# ---------- 远程 MCP Streamable HTTP（独立入口）----------
# 必填；使用独立随机令牌，不能复用后端服务认证令牌。
SCHEDULE_MCP_HTTP_TOKEN=
SCHEDULE_MCP_HTTP_HOST=127.0.0.1
SCHEDULE_MCP_HTTP_PORT=7801
# 带 Origin 的请求仅接受列表中的完整来源，逗号分隔；默认拒绝带 Origin 的请求。
SCHEDULE_MCP_ALLOWED_ORIGINS=
